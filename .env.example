# Template for .env. Copy and fill in, then check:
#   cp .env.example .env && chmod 600 .env
#   scripts/check-env.sh
# Never put real secrets in this file: it is in git. See README "Miljøvariable".

# --- Secrets: unique per instance, generate new ones for a new or recovery instance ---
# openssl rand -hex 32
JWT_SECRET=<generate>
# python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
FERNET_KEY=<generate>
# MongoDB root user, set when the database is created (data/db is empty).
# Not part of the backups: a recovery instance can use its own.
DB_USER=admin
DB_PASSWORD=<generate>
# Admin login for the GUI and services. Get it from the password manager.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<from password manager>

# --- Login and session ---
JWT_EXP_DELTA_SECONDS=3600        # token lifetime, renewed for active users
JWT_MAX_SESSION_SECONDS=86400     # max length of a login
SESSION_COOKIE_SECURE=false       # true only when the GUI is reached via https

# --- Instance (shown in the GUI) ---
INSTANCE_NAME="<name, e.g. UpCloud prod>"
INSTANCE_ROLE=standby             # production | standby | test

# --- Logging ---
LOGGING_LEVEL=INFO

# --- integration-service: photos and Google Cloud ---
# The key file itself is mounted from ./application_default_credentials.json (not in git).
GOOGLE_APPLICATION_CREDENTIALS="application_default_credentials.json"
GOOGLE_CLOUD_PROJECT=sigma-celerity-257719
GOOGLE_STORAGE_BUCKET=langrenn-sprint
GOOGLE_STORAGE_SERVER=https://storage.googleapis.com
LOCAL_PHOTO_DIRECTORY=./files     # folder on this machine with photos

# --- Backup (scripts/backup.sh), optional ---
# BACKUP_KEEP_HOURS=48
# BACKUP_KEEP_DAYS=30
# BACKUP_GCS_BUCKET=<private backup bucket>
# BACKUP_GCS_PREFIX=mongo
# BACKUP_GCS_CREDENTIALS=backup-sa.json
